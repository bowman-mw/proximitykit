{
  "sourceLanguage" : "en",
  "strings" : {
    "friendPhoto.error.nothingSaved" : {
      "comment" : "Shown after saving shared friend photos when every image failed to decode, so no asset was created. Reports the real outcome rather than a false success.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "None of the selected pictures could be saved."
          }
        }
      }
    },
    "proximity.camera.holdFailed" : {
      "comment" : "Alert on the in-person camera when a photo just taken could not be saved securely on this phone. No film was used and nothing was shared.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't keep that photo. Try again."
          }
        }
      }
    },
    "proximity.keepFriends.done" : {
      "comment" : "Button that closes the end-of-session sheet and saves the keep-as-friend choices.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Done"
          }
        }
      }
    },
    "proximity.keepFriends.explainer" : {
      "comment" : "Body under the keep-as-friends heading. Must keep saying that the choice is private to this user and that the other person is never told either way.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Friends stay on your list for good vibes and future hangouts. This is just for you — they won't be notified either way."
          }
        }
      }
    },
    "proximity.keepFriends.keep" : {
      "comment" : "Chip beside one person met during the session, in its unselected state. Tapping it keeps them as a friend.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep"
          }
        }
      }
    },
    "proximity.keepFriends.keeping" : {
      "comment" : "The keep-as-friend chip in its selected state. Present participle: it describes what will happen, not a completed action.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeping"
          }
        }
      }
    },
    "proximity.keepFriends.sectionTitle" : {
      "comment" : "Heading of the list of people met during the session, each with a keep-or-not choice.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep as friends?"
          }
        }
      }
    },
    "proximity.keepFriends.sessionTitle" : {
      "comment" : "Warm title of the sheet shown when an in-person session ends without photos, asking whether to keep the people met as friends.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nice hangout!"
          }
        }
      }
    },
    "proximity.peer.someoneNearby" : {
      "comment" : "Stands in for a nearby person whose name has not been shared yet: the connect rows on the Friends tab, the session's participant list, a join request, a recipe recipient. A plain phrase, shown where a name would be.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Someone nearby"
          }
        }
      }
    },
    "proximity.peer.someoneYouMet" : {
      "comment" : "Stands in for a person met in person whose name never arrived before the connection ended: the keep-as-friend rows at the end of a session and the Friends & Blocks list.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Someone you met"
          }
        }
      }
    },
    "proximity.review.alsoSaveToPhotos.toggle" : {
      "comment" : "Toggle on the photo review sheet, off each time. When on, the photos the person keeps are also copied to the system Photos library after they are kept in Fernlet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Also save kept photos to Photos"
          }
        }
      }
    },
    "proximity.review.answerFailed" : {
      "comment" : "Inline message on the photo review sheet when the person's keep/delete answer could not be applied. The photos are still waiting, untouched.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't save your choice. Nothing was lost. Try again."
          }
        }
      }
    },
    "proximity.review.deleteAll" : {
      "comment" : "Destructive button of the photo review sheet. The count is deliberate: it turns a mis-tap into a visible amount of loss.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Delete all %lld"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Delete all %lld"
                }
              }
            }
          }
        }
      }
    },
    "proximity.review.deleteOne" : {
      "comment" : "Destructive button of the photo review sheet when there is exactly one picture.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delete it"
          }
        }
      }
    },
    "proximity.review.endingSession" : {
      "comment" : "Status line on the photo review while Fernlet finishes leaving the in-person session that just ended; the buttons are disabled meanwhile. Takes at most a few seconds.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ending the session..."
          }
        }
      }
    },
    "proximity.review.explainer.pending" : {
      "comment" : "Explainer under the photo review sheet's title. Two promises, both load-bearing: nothing is saved (not to Fernlet, not to the camera roll) until the person chooses, and unkept photos are deleted from this phone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing from this session is saved until you choose. Photos you don't keep are deleted from this phone."
          }
        }
      }
    },
    "proximity.review.keepSelected" : {
      "comment" : "Affirmative button of the photo review sheet: keeps the ticked pictures inside Fernlet. Copying them to the Photos library is a separate toggle, applied only after the keep.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep selected"
          }
        }
      }
    },
    "proximity.review.keepUnavailable" : {
      "comment" : "Line on the photo review sheet shown when the Keep button is disabled because the saved photo album cannot be read right now. Delete all still works.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeping isn't possible right now because your saved photos can't be read. You can delete these, or choose later."
          }
        }
      }
    },
    "proximity.review.notNow" : {
      "comment" : "Text button at the top of the review shown when an in-person photo session ends. Hides the review without keeping or deleting anything; the photos keep waiting, unsaved, and the review comes back the next time Fernlet opens.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not now"
          }
        }
      }
    },
    "proximity.review.savingToPhotos" : {
      "comment" : "Status line on the photo review sheet while kept photos are copied to the system Photos library; the buttons are disabled meanwhile.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saving to Photos..."
          }
        }
      }
    },
    "proximity.review.snapshotCover" : {
      "comment" : "Label on the opaque cover over the photo review while the app is not frontmost, so the app switcher never shows photos that have not been chosen yet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Photos hidden"
          }
        }
      }
    },
    "proximity.review.tile.hint" : {
      "comment" : "VoiceOver hint on one photo in the session review grid: double-tapping ticks or unticks it for keeping. Its selected state is announced separately.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Double-tap to keep or not keep."
          }
        }
      }
    },
    "proximity.review.tile.label" : {
      "comment" : "VoiceOver label of one photo in the session review grid. The argument is the name of the person who took it, or a plain phrase such as 'Someone you met' when their name is not known.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Photo from %@"
          }
        }
      }
    },
    "proximity.review.title" : {
      "comment" : "Title of the sheet shown after a shared photo session, where the user picks which pictures taken of them to keep.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Review pictures"
          }
        }
      }
    },
    "proximity.review.unreadable" : {
      "comment" : "Notice on the photo review sheet after an answer, when some photos the person chose to keep could not be opened and were removed instead. The count is how many.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 photo couldn't be opened and was removed."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld photos couldn't be opened and were removed."
                }
              }
            }
          }
        }
      }
    },
    "proximity.saveFailure.corruptedMany" : {
      "comment" : "Body of the photo-save failure alert when several pictures were being saved and every one failed to decode.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "None of the selected pictures could be saved. They may be corrupted — try choosing different ones."
          }
        }
      }
    },
    "proximity.saveFailure.corruptedOne" : {
      "comment" : "Body of the photo-save failure alert when exactly one picture was being saved and it failed to decode.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This picture couldn't be saved. It may be corrupted."
          }
        }
      }
    },
    "proximity.saveFailure.generic" : {
      "comment" : "Body of the photo-save failure alert when the cause is unknown, and also when a picture's bytes could not be read back from the encrypted cache at all.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not save to your photo library. Please try again."
          }
        }
      }
    },
    "proximity.saveFailure.ok" : {
      "comment" : "Cancel-role button dismissing the photo-save failure alert.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OK"
          }
        }
      }
    },
    "proximity.saveFailure.openSettings" : {
      "comment" : "Button on the photo-save failure alert that opens the app's own page in the system Settings, where the Photos permission can be granted.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open Settings"
          }
        }
      }
    },
    "proximity.saveFailure.permissionDenied" : {
      "comment" : "Body of the photo-save failure alert when the user denied add-only Photos access. This is the only failure that offers the Open Settings button.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet needs access to your Photo Library to save photos. Open Settings to grant access."
          }
        }
      }
    }
  },
  "version" : "1.0"
}